{
  "name": "forca-caos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Jogo da Forca multiplayer competitivo com power-ups, em Cloudflare Pages + D1.",
  "scripts": {
    "dev": "wrangler pages dev public --port 8788 --persist-to .wrangler/state --d1=DB=00000000-0000-0000-0000-000000000000",
    "db:local": "wrangler d1 execute forca-caos-db --local --file=migrations/0001_init.sql --persist-to .wrangler/state",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "node scripts/check.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "vitest": "^3.2.4",
    "wrangler": "^4.156.0"
  }
}
